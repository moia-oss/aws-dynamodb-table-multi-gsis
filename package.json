{
  "name": "@moia-dev/aws-dynamodb-table-multi-gsis",
  "repository": {
    "type": "git",
    "url": "https://github.com/moia-oss/aws-dynamodb-table-multi-gsis.git"
  },
  "scripts": {
    "build": "npx tsc",
    "eslint": "npx eslint",
    "publish": "npm publish",
    "test": "npx projen test",
    "bundle:dynamoDBUpdateTable.lambda": "esbuild src/dynamoDBUpdateTable.lambda.ts --bundle --platform=node --target=node18 --outfile=assets/dynamoDBUpdateTable.lambda/index.js"
  },
  "author": {
    "name": "Florian CHAZAL",
    "email": "florianchazal@gmail.com",
    "organization": false
  },
  "devDependencies": {
    "@aws-cdk/assert": "^2.68.0",
    "@types/aws-lambda": "8.10.152",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "aws-cdk-lib": "2.207.0",
    "aws-sdk": "2.1692.0",
    "constructs": "10.4.2",
    "esbuild": "^0.25.8",
    "eslint": "^9",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30",
    "jest-junit": "^16",
    "jest-runner-groups": "^2.2.0",
    "jsii": "^5.8.16",
    "jsii-diff": "^1.112.0",
    "jsii-docgen": "^10.7.6",
    "jsii-pacmak": "^1.112.0",
    "json-schema": "^0.4.0",
    "npm-check-updates": "^18.0.2",
    "projen": "^0.95.0",
    "standard-version": "^9",
    "ts-jest": "^29",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "cdk"
  ],
  "main": "lib/index.js",
  "license": "Apache-2.0",
  "version": "0.6.0",
  "jest": {
    "runner": "groups",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.ts?(x)",
      "<rootDir>/(test|src)/**/?(*.)+(spec|test).ts?(x)"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "preset": "ts-jest",
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.dev.json"
      }
    }
  },
  "types": "lib/index.d.ts",
  "stability": "stable",
  "jsii": {
    "outdir": "dist",
    "targets": {},
    "tsc": {
      "outDir": "lib",
      "rootDir": "src"
    }
  },
  "publishConfig": {
    "registry": "https://moiadev.jfrog.io/moiadev/api/npm/npm-local/"
  }
}
